# ════════════════════════════════════════════════════════════════
#  KUKU EVERYTHING — Backend Environment Variables
# ════════════════════════════════════════════════════════════════

# ── Django core ────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ════════════════════════════════════════════════════════════════
#  EMAIL — FREE via Gmail SMTP (500 emails/day, totally free)
# ════════════════════════════════════════════════════════════════
#
# HOW TO SET UP (5 minutes):
#   1. Go to https://myaccount.google.com/security
#   2. Turn ON "2-Step Verification"
#   3. Search "App passwords" in that page
#   4. Select app = "Mail", device = "Other" → name it "KUKU"
#   5. Google gives you a 16-character password → paste below
#
# IN DEVELOPMENT (no Gmail yet):
#   Leave EMAIL_BACKEND as console → emails print to terminal.
#   No setup needed at all!
#
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Uncomment + fill when ready for real email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=yourgmail@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# DEFAULT_FROM_EMAIL=KUKU EVERYTHING <yourgmail@gmail.com>


# ════════════════════════════════════════════════════════════════
#  SMS — Choose ONE of the free options below
# ════════════════════════════════════════════════════════════════
#
# IN DEVELOPMENT: Leave as 'console' → SMS prints to terminal.
# No account needed!
#
SMS_PROVIDER=console


# ── OPTION A: Africa's Talking (BEST for Tanzania) ─────────────
# FREE sandbox: go to https://africastalking.com/ and sign up (free).
# In sandbox mode, SMS shows in the AT web simulator — not a real phone.
# To go LIVE: verify account → add TZS credit (≈ TZS 25 per SMS).
#
# Steps:
#   1. Register at africastalking.com
#   2. Go to Sandbox → Settings → API Key → copy it
#   3. Fill AFRICASTALKING_API_KEY below
#   4. For sandbox: AFRICASTALKING_USERNAME=sandbox
#   5. For live:    AFRICASTALKING_USERNAME=your_at_username
#   6. Set SMS_PROVIDER=africastalking
#
# SMS_PROVIDER=africastalking
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=your_sandbox_api_key_here
# AFRICASTALKING_SENDER_ID=KUKU


# ── OPTION B: Twilio (FREE $15 trial credit ≈ 100+ SMS) ────────
# Steps:
#   1. Register at https://twilio.com/ (no card needed for trial)
#   2. Get a free phone number
#   3. Copy Account SID, Auth Token, and your Twilio number
#   4. Install twilio: pip install twilio
#   5. Set SMS_PROVIDER=twilio
#
# Note: Trial account can only SMS to verified numbers unless upgraded.
# Upgrade costs ~$0.05/SMS to Tanzania.
#
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+12025551234

# ── OPTION C: Beem Africa (CHEAPEST for Tanzania ~TZS 18/SMS) ──
# Register FREE at https://beem.africa/
# Steps:
#   1. Sign up at beem.africa
#   2. Dashboard → API Access → copy API Key & Secret Key
#   3. Add minimum TZS 5,000 balance to send real SMS
#   4. Register sender name "KUKU" (takes 1-2 days approval from TCRA)
#   5. Set SMS_PROVIDER=beem
#
# SMS_PROVIDER=beem
# BEEM_API_KEY=your_api_key_here
# BEEM_SECRET_KEY=your_secret_key_here
# BEEM_SENDER_NAME=KUKU
